<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Talks to the WhatsApp / WhatsApp Business app already on the phone -->
    <uses-permission android:name="android.permission.INTERNET" /> <!-- update checker only -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="replace" /> <!-- detect which of WhatsApp / WA Business is installed -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" /> <!-- Auto-Unlock Device setting -->

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".ScopeWaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ScopeWa"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScopeWa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HANDS layer — see ARCHITECTURE-V2-WHATSAPP.md section 5.1/5.2.
             All WhatsApp-specific selectors live in accessibility/WaSelectors.kt, not here. -->
        <service
            android:name=".accessibility.WaAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Reply listener — architecture doc section 6 layer 3. Sees STOP/ACHA/SITAKI
             replies arrive while WhatsApp is backgrounded, which the Accessibility
             service cannot. Everything not from WhatsApp is discarded in
             brain/reply/ReplyNotificationParser.kt before anything else happens. -->
        <service
            android:name=".accessibility.WaNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- JOB RUNNER layer — foreground service driving a campaign step by step. -->
        <service
            android:name=".jobrunner.CampaignJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
